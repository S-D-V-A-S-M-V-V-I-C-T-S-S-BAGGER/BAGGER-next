{
  "extends": ["//"],
  "tasks": {
    "build": {
      "env": [
        "PORT",
        "SHEETS_API_KEY",
        "SERVICE_CLIENT_EMAIL",
        "SERVICE_CLIENT_KEY",
        "BAFKO_SHEET_ID",
        "BAFKO_SHEET_RANGE",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_GOOGLE_REDIRECT",
        "AUTH_SIGN_SECRET",
        "GOOGLE_CLIENT_SECRETS_PATH"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "env": [
        "PORT",
        "DEBUG",
        "SHEETS_API_KEY",
        "SERVICE_CLIENT_EMAIL",
        "SERVICE_CLIENT_KEY",
        "BAFKO_SHEET_ID",
        "BAFKO_SHEET_RANGE",
        "AUTH_GOOGLE_ID",
        "AUTH_GOOGLE_SECRET",
        "AUTH_GOOGLE_REDIRECT",
        "AUTH_SIGN_SECRET",
        "GOOGLE_CLIENT_SECRETS_PATH"
      ]
    }
  }
}
