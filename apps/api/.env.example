DEBUG=# A list of space or comma delimited namespaces for the debug library, denoting which namespaces should be logged. For example: "*"
# Google API configuration
SHEETS_API_KEY=# Google Cloud API key (https://cloud.google.com/docs/authentication/api-keys#create)
SERVICE_CLIENT_EMAIL=# Email of Google Cloud API service account (https://cloud.google.com/iam/docs/service-accounts-create?hl=en#creating)
SERVICE_CLIENT_KEY=# Base 64 encoded private key of Google Cloud API service account
# Google Auth configuration
AUTH_GOOGLE_ID=# The OAuth client ID found at console.cloud.google.com/apis/credentials
AUTH_GOOGLE_SECRET=# The OAuth client secret found at console.cloud.google.com/apis/credentials
AUTH_GOOGLE_REDIRECT=# URL to redirect to after Google auth
# BAGGER Auth configuration
AUTH_SIGN_SECRET=# A secret used for singing tokens, generated using "openssl rand -base64 40" (or any other value > 32)
COOKIE_SIGN_SECRET=# A secret used for singing tokens, generated using "openssl rand -base64 40" (or any other value > 32)
GOOGLE_CLIENT_SECRETS_PATH=# Path to store session info
### Sheets ###
# Bafko
BAFKO_SHEET_ID=# Google Sheets id from docs.google.com/spreadsheets/d/[id]
BAFKO_SHEET_RANGE=# Google Sheets range containing valid BAfko's, such as 'Afko''s'!B3:D
